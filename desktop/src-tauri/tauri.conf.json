{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XNG",
  "version": "0.23.2",
  "identifier": "io.airframes.xng",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XNG",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; worker-src 'self' blob:; child-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Multi-mode SDR decoder",
    "longDescription": "xng decodes ACARS, VDL2, HFDL, satcom, AIS, ADS-B and more from an SDR or an IQ recording, with a live map, message browser and spectrum.",
    "copyright": "xng contributors",
    "license": "MIT OR Apache-2.0",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libsoapysdr0.8", "libairspy0", "libairspyhf1"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
