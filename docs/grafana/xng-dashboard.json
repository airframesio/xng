{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "title": "xng — SDR decoder",
  "uid": "xng-decoder",
  "tags": ["xng", "sdr", "acars", "adsb", "ais"],
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "mode",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(xng_frames_total, mode)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Frame rate (frames/s) by mode·freq",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "rate(xng_frames_total{mode=~\"$mode\"}[5m])", "legendFormat": "{{mode}} {{freq}}" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "CRC-OK ratio by mode·freq",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "expr": "rate(xng_frames_crc_ok_total{mode=~\"$mode\"}[5m]) / clamp_min(rate(xng_frames_total{mode=~\"$mode\"}[5m]), 1e-9)", "legendFormat": "{{mode}} {{freq}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Channel level (dBFS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "expr": "xng_channel_level_dbfs{mode=~\"$mode\"}", "legendFormat": "{{mode}} {{freq}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "FEC-corrected units/s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "rate(xng_fec_corrected_total{mode=~\"$mode\"}[5m])", "legendFormat": "{{mode}} {{freq}}" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Top ACARS labels (msgs/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "topk(10, rate(xng_acars_messages_total[5m]))", "legendFormat": "{{label}} @ {{freq}}" }
      ]
    },
    {
      "id": 6, "type": "stat", "title": "Sample throughput (S/s) by mode",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "sps" }, "overrides": [] },
      "targets": [
        { "expr": "rate(xng_samples_total{mode=~\"$mode\"}[5m])", "legendFormat": "{{mode}}" }
      ]
    }
  ]
}
